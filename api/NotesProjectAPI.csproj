    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>1066d57e-44f8-46fc-9b96-f64f609e2bfb</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
